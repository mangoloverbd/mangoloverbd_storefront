# ─── Required ─────────────────────────────────────────────────
# Your Merchant-Suite storefront handle (claimed via the dashboard)
VITE_STOREFRONT_HANDLE=

# Merchant-Suite API base URL
VITE_API_URL=https://merchant-suite.online

# ─── Optional ─────────────────────────────────────────────────
# Meta Pixel ID for client-side tracking (leave empty to disable)
VITE_META_PIXEL_ID=

# bKash "Send Money" number — if set, bKash payment option appears in checkout
VITE_BKASH_NUMBER=

# ─── Server-side (for Meta CAPI) ─────────────────────────────
META_PIXEL_ID=
META_CAPI_ACCESS_TOKEN=
META_TEST_EVENT_CODE=

# ─── Dev Server ──────────────────────────────────────────────
PORT=5000
