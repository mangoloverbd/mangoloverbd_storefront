# Storefront <-> Merchant Suite connection (single-storefront, single-tenant)
# The canonical public storefront API: {MERCHANT_SUITE_URL}/api/public/v1/storefronts/{VITE_STOREFRONT_ID}/products

# Client (Vite) — catalog reads from the browser.
# Local dev: point at the running Commerce-os server (e.g. http://localhost:5100).
# Prod:      the public URL of your deployed Merchant Suite.
VITE_MERCHANT_SUITE_URL=http://localhost:5100
VITE_STOREFRONT_ID=2a155750-b11a-4ff2-a7ff-4e26daac46ef

# Server (Express) — order checkout posts to the Merchant Suite custom-orders webhook.
# Keep these in sync with the backend above; the API key must be registered in the
# Merchant Suite app_settings as "<orgId>:custom_store_api_key".
MERCHANT_SUITE_URL=http://localhost:5100
CUSTOM_ORDERS_API_KEY=stepprsbangladesh-098765

# Meta Conversions API (optional). Server-side dedup of Pixel events.
META_PIXEL_ID=
META_ACCESS_TOKEN=
LINKEDIN_DATATRANSFERS_KEY=